# GREGAI: szablon konfiguracji. `bash install.sh` tworzy z niego plik .env,
# jeśli go jeszcze nie ma. .env zawiera sekrety: prawa 600, NIGDY nie trafia
# do paczki ani do gita. Wartości poniżej to ustawienia, które zakłada install.sh
# (stable 1.0); gdy klucza brakuje w .env, kod używa własnego, ostrożniejszego
# domyślnego (np. chmura i SYSOP wyłączone), dlatego ich nie kasuj.
# Komentarze piszesz w OSOBNEJ linii (zaczynają się od #). Komentarz po wartości
# w tej samej linii (KLUCZ=wartość # uwaga) zostałby wczytany jako część wartości.

# Dostęp do GREGAI: 0 = tylko ten komputer (http://localhost:7777), nic w
# sieci. 1 = sieć domowa z tokenem (serwer bez pulpitu). GREGAI_TOKEN
# (token dla żądań spoza tego komputera) install.sh generuje sam przy pierwszej
# instalacji i dopisuje do .env; nie wpisuj go do szablonu.
GREGAI_LAN=0

# Nazwy hostów za pośrednikiem (tunel), oddzielone przecinkami. Puste = żadne żądanie
# z nagłówkami pośrednika (X-Forwarded-For itp.) nie przejdzie testu Hosta.
GREGAI_TUNEL_HOSTY=

# Kto jest "twórcą" tej instalacji GREGAI (odpowiedź na "kto cię stworzył?").
# Puste = generyczne "administrator tej instalacji" - bezpieczny domyślny wybór
# dla kogoś innego niż autor oryginalnego projektu. Wpisz tu swoje imię (albo
# imię i nazwisko), jeśli chcesz, żeby GREGAI odpowiadał Twoim imieniem.
GREGAI_CREATOR_NAME=

# Imię UŻYTKOWNIKA, do którego GREGAI się zwraca w rozmowie i w promptach
# wewnętrznych (streszczenia, namysł, raporty). Puste = domyślnie "Grzegorz"
# (dokładnie to, co było literałem w kodzie przed 1.32.21 - zero zmiany
# zachowania, dopóki tego nie ustawisz). Polskie przypadki wymagają TRZECH
# osobnych kluczy, bo odmiana imion jest nieregularna (np. "Marek" ->
# "Marka", nie automatyczny wzorzec) - podaj własne, poprawnie odmienione
# formy.
GREGAI_USER_NAME=
GREGAI_USER_NAME_GENITIVE=
GREGAI_USER_NAME_VOCATIVE=

# Rodzaj UŻYTKOWNIKA - steruje WYŁĄCZNIE treścią instrukcji stylu dla modelu
# ("formy męskie"/"formy żeńskie"), nie wymusza gramatyki w generowanym
# tekście (to zawsze zależało od modelu). Puste albo "m" = męski (domyślnie,
# zero zmiany zachowania). Wpisz "z" dla formy żeńskiej.
GREGAI_USER_GENDER=

# Duży model lokalny (Qwen2.5-3B: kompromis szybkość/jakość na tym CPU) i okno
# kontekstu, w którym mieści się cały prompt GREGAI + historia rozmowy
# (16384 od 2026-10-19, podwojone z 8192, żeby GREGAI nie gubił wątku w
# dłuższych rozmowach; patrz "Co nowego" w README).
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_NUM_CTX=16384
# Miasto do pogody i do wyliczania wschodu/zachodu słońca (1.30.31, agent/pogoda.py).
# Warszawa ma wbudowane współrzędne; dla innego miasta wpisz też GREGAI_LAT i GREGAI_LON
# (np. Kraków: 50.0647 i 19.9450), inaczej słońce w bloku "Teraz" nie jest liczone.
GREGAI_MIASTO=Warszawa
# Wyszukiwarki w kolejności prób (1.32.0, agent/tools.py: research_web). DuckDuckGo
# często odrzuca ruch z WARP stroną-wyzwaniem - wtedy GREGAI sam przechodzi do
# następnej, a odrzucająca odpoczywa 10 minut. Do wyboru: duckduckgo, mojeek, bing,
# wikipedia. To samo krótkie zapytanie może trafić do kilku z nich po kolei.
SZUKAJ_SILNIKI=duckduckgo,mojeek,bing,wikipedia

# KORYTO (1.17.0, agent/koryto.py): JEDNA kolejność dostawców dla CAŁEGO
# myślenia GREGAI - rozmowy, Namysłu, decyzji o narzędziu, planera zadań,
# streszczeń. "Cały program to koryto, zmienia się tylko, co przez nie płynie."
# Etapy, oddzielone przecinkami, próbowane po kolei (pierwszy sukces wygrywa):
#   anthropic - Claude (Anthropic, PŁATNY; klucz niżej) - domyślnie PIERWSZY,
#   darmowe   - darmowa pula (Groq, Gemini, OpenRouter, Hugging Face,
#               Cloudflare; klucze niżej), w losowej kolejności - rezerwa,
#   lokalnie  - ten komputer (Ollama) - ostateczna rezerwa; jedyny etap, który
#               działa bez internetu/WARP (agent/netguard.py, fail-closed).
# Etap bez klucza po prostu nie istnieje, koryto płynie dalej. Etap pominięty
# tutaj nie jest używany wcale (np. KORYTO=anthropic,lokalnie = bez darmowych).
# Stare JUGGLER_MODE/CLOUD_FALLBACK z wcześniejszych .env są ignorowane.
KORYTO=anthropic,darmowe,lokalnie
# Krok 1 routera (decyzja "czy i jakie narzędzie", chudy prompt z samą
# wiadomością) i planer pętli zadań SYSOP (w jego prompcie są obserwacje z
# narzędzi: stan systemu, fragmenty logów/plików - zmaskowane) też idą
# korytem. 0 = ten etap zostaje lokalny (jak do 1.16.x).
KORYTO_ROUTING=1
KORYTO_ZADANIA=1
# Łączny budżet czasu jednego łańcucha dostawców sieciowych (sekundy): po jego
# wyczerpaniu koryto oddaje lokalnemu modelowi zamiast sumować limity dostawców.
# KORYTO_BUDZET_S=120
# Budżet czasu sieci całej jednej wiadomości (sekundy czekania na dostawców,
# wszystkie zapytania razem; praca narzędzi się nie liczy). Dostawca, który
# w tej samej wiadomości zawiódł dwa razy, nie jest już pytany.
# KORYTO_BUDZET_WIADOMOSC_S=600
# Budżet pieniężny Claude (1.20.0): GREGAI liczy wydatki z tokenów zwracanych
# przez API i po przekroczeniu limitu przestaje pytać Claude'a (rozmowę przejmuje
# darmowa pula albo lokalny model). To SZACUNEK z cen poniżej (USD za milion
# tokenów; sprawdź aktualne w Claude Console), rachunek prowadzi Anthropic.
# Dziennik przeżywa restart (data/koryto_dziennik.json). 0 = bez limitu.
# KORYTO_BUDZET_MIESIAC_USD=20
# KORYTO_BUDZET_DZIEN_USD=1.5
# KORYTO_CENA_WEJSCIE_USD=1.0
# KORYTO_CENA_WYJSCIE_USD=5.0
# Straż (agent/straz.py): patrol komputera bez AI (nowe porty, zmiany .env i kodu,
# nieudane logowania), model ocenia tylko anomalie, w limitach. STRAZ=0 wyłącza.
# STRAZ=1
# STRAZ_CO_S=60
# STRAZ_OCEN_NA_GODZINE=6
# STRAZ_OCEN_NA_DOBE=40
# STRAZ_PROG_LOGOWAN=5
# Kiedy liczy lokalny model: bez_internetu (domyślne) = TYLKO gdy nie ma
# internetu/WARP albo żadnego klucza sieciowego - gdy sieciowi po prostu nie
# odpowiedzą, dostajesz krótki komunikat z powodami zamiast minut liczenia na
# CPU; zawsze = lokalny także jako rezerwa po porażce sieciowych.
# KORYTO_LOKALNIE=bez_internetu

# Claude (Anthropic): klucz z console.anthropic.com (install.sh zapyta o niego;
# puste = etap "anthropic" nieaktywny, koryto zaczyna od darmowej puli).
# Dzienny limit zapytań to jedyny bezpiecznik kosztów (Claude jest płatny per
# token; 300 krótkich zapytań Haiku dziennie to rząd kilkudziesięciu groszy).
# Model: domyślnie claude-haiku-5-5 (najtańszy, najszybszy); mocniejszy =
# ANTHROPIC_MODEL=claude-sonnet-5-5 (stara nazwa CLOUD_MODEL też działa).
ANTHROPIC_API_KEY=
CLOUD_DAILY_LIMIT=300
# ANTHROPIC_MODEL=claude-haiku-5-5
# Mocniejszy Claude TYLKO do myślenia Namysłu (plan, analiza), routing i czat zostają
# na tanim modelu wyżej. Domyślnie claude-sonnet-5-5 (ok. 3x drożej za głębokie pytanie,
# dzienny budżet KORYTO_BUDZET_* i tak to ogranicza). Taniej: NAMYSL_MODEL=claude-haiku-5-5;
# bez dopłaty (to samo co czat): NAMYSL_MODEL=off
# NAMYSL_MODEL=claude-sonnet-5-5

# Rozdzielnica (1.30.23): waga uwagi (skupienie 1-4, agent/skupienie.py) decyduje,
# ile płatnego Claude zużyć. B (domyślna): darmowa pula ZAWSZE pierwsza, Claude jako
# eskalacja dopiero od wagi 3 (przy 4 z modelem NAMYSL_MODEL), waga 1-2 bez płatnego.
# A (oszczędniejsza): płatny dopiero od wagi 4. 0/off: wyłączona (kolejność i model
# ściśle wg KORYTO/NAMYSL_MODEL, jak dawniej). Respektuje KORYTO (nie wskrzesza
# etapu, który tam wyłączyłeś). Licznik oszczędności widać na /debug.
# ROZDZIELNICA=B

# Darmowa pula (agent/juggler.py): "wkłady" wymienne pod jednym złączem,
# GREGAI sam się nie zmienia. Kolejność prób w tym etapie jest losowana przy
# każdym zapytaniu (żaden pojedynczy darmowy dostawca nie widzi całego ruchu).
# install.sh zapyta o każdy klucz z osobna; puste = ten dostawca pomijany,
# reszta działa normalnie. Klucze: Groq (console.groq.com), Gemini
# (aistudio.google.com/apikey), OpenRouter (openrouter.ai/keys), Hugging
# Face (huggingface.co/settings/tokens), Cloudflare (panel Cloudflare ->
# Workers & Pages -> Workers AI -> "Use REST API" - stamtąd też klucz I
# Account ID). Cloudflare to JEDYNY z nich, który poza kluczem potrzebuje
# też CLOUDFLARE_ACCOUNT_ID niżej (install.sh zapyta o niego osobno,
# zaraz po kluczu Cloudflare) - bez obu naraz ten jeden dostawca zostaje
# pominięty, reszta puli działa jak zwykle.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
HUGGINGFACE_API_KEY=
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=

# Warstwa systemowa SYSOP: stałe, nazwane narzędzia (stan, usługi, logi,
# aktualizacje, sieć, procesy, timery, pliki, kopia zapasowa). Dowolny shell
# jest domyślnie WYŁĄCZONY; włączasz go świadomie (SYSOP_SHELL=1 + restart).
SYSOP_ENABLED=1
SYSOP_USE_SUDO=1
SYSOP_SHELL=0
# TRYB PEŁNY (1.17.0, agent/sysop.py "Tryb PEŁNY"): dla GREGAI na WYIZOLOWANYM
# Ubuntu, które jest tylko jego. SYSOP_MODE=pelny = dowolny shell zawsze (także
# sudo), pliki w całym systemie (poza .env), każda usługa systemd, sudo bez
# hasła do wszystkiego (install.sh pisze wtedy "ALL=(ALL) NOPASSWD: ALL"),
# zwykłe zmiany BEZ pytania. Polecenia nieodwracalne/osłabiające zabezpieczenia
# (rm -rf /, ufw disable, sudoers, kod GREGAI) - za JEDNYM potwierdzeniem.
# SYSOP_PYTAJ (tylko w trybie pełnym): niebezpieczne (domyślne: karta tylko dla
# nieodwracalnych), zmiany (karta także dla zwykłych zmian), nigdy (zero kart -
# pełne zaufanie, pełna odpowiedzialność). Zmiana trybu = wpis tutaj + `bash
# install.sh` (sudoers) + restart. Domyślnie (bez wpisu): strazniczy = jak dotąd.
# SYSOP_MODE=pelny
# SYSOP_PYTAJ=niebezpieczne

# Cloudflare WARP nie ma tu przełącznika: jest obowiązkowy i wbudowany
# (agent/netguard.py, fail-closed).

# ---------------------------------------------------------------------------
# Ustawienia dodatkowe. Wszystkie opcjonalne: poniżej wartości domyślne, więc
# bez odkomentowania nic się nie zmienia. Odkomentuj tylko to, co chcesz zmienić
# (po zmianie: przycisk "Zrestartuj GREGAI" na http://localhost:7777/debug).
# ---------------------------------------------------------------------------

# Router domowy (stan sieci, sygnał, zużycie danych). Bez hasła GREGAI pokazuje
# tylko skan urządzeń. Hasło wpisz TUTAJ, nigdy w rozmowie.
# ROUTER_HOST = adres Twojej bramy domowej (ip route | grep default); domyślne
# 192.168.8.1 to fabryczny Huawei. Inna brama = ustaw PRZED install.sh, inaczej
# GREGAI nigdy nie uzna, że jest w domu, i nie skanuje sieci.
# ROUTER_HOST=192.168.8.1
# ROUTER_SCHEME=https
# ROUTER_USER=
# ROUTER_PASSWORD=

# Claude: długość odpowiedzi (tokeny) i limit czasu (sekundy). Model i
# dzienny limit zapytań ustawiasz wyżej (ANTHROPIC_MODEL, CLOUD_DAILY_LIMIT).
# CLOUD_MAX_TOKENS=1600
# CLOUD_TIMEOUT=60

# Żongler (agent/juggler.py): modele i dzienne limity darmowe PER DOSTAWCA
# (domyślne poniżej to bezpieczne, ostrożne wartości - stan na 2026-10).
# Gemini: Google nie publikuje już jednej tabeli darmowych limitów - sprawdź
# własny na aistudio.google.com (zakładka "Rate limits") i podnieś, jeśli wyższy.
# OpenRouter: model "openrouter/free" to auto-router, sam wybiera wśród
# aktualnie darmowych modeli (50/dzień, 20/min - limit potwierdzony).
# Hugging Face: darmowy limit to NIE liczba zapytań, tylko 0,10 USD kredytu
# MIESIĘCZNIE na cały router (stan 2026-10, może się zmienić - sprawdź
# huggingface.co/docs/inference-providers) - HUGGINGFACE_DAILY_LIMIT=20 to
# tylko ostrożne przybliżenie, obniż, jeśli HF zacznie odrzucać zapytania
# przed wyczerpaniem licznika.
# Cloudflare: darmowy limit to 10 000 "neuronów"/dzień (reset 00:00 UTC) -
# ile to odpowiedzi zależy od modelu, CLOUDFLARE_DAILY_LIMIT=500 to ostrożny
# margines poniżej szacunku (~1000-1300+/dzień dla małego modelu); podnieś,
# jeśli panel Cloudflare pokazuje spory zapas.
# GROQ_MODEL=openai/gpt-oss-20b
# GROQ_DAILY_LIMIT=1000
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_DAILY_LIMIT=100
# OPENROUTER_MODEL=openrouter/free
# OPENROUTER_DAILY_LIMIT=50
# HUGGINGFACE_MODEL=openai/gpt-oss-20b
# HUGGINGFACE_DAILY_LIMIT=20
# CLOUDFLARE_MODEL=@cf/openai/gpt-oss-20b
# CLOUDFLARE_DAILY_LIMIT=500
# JUGGLER_MAX_TOKENS=1600
# JUGGLER_TIMEOUT=60

# Lokalne modele (Ollama). GREGAI łączy się z Ollamą WYŁĄCZNIE lokalnie.
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_TEMPERATURE=0.2
# Limity czasu odpowiedzi (sekundy): duży model jako planer zadań i przy routingu
# (BIG_MODEL_ROUTING=1), rozmowa z pełnym promptem, router, uczeń, planer,
# rozgrzewanie modeli po starcie.
# OLLAMA_TIMEOUT=240
# RICH_TIMEOUT=900
# ROUTER_TIMEOUT=30
# STUDENT_TIMEOUT=120
# PLANNER_TIMEOUT=60
# WARMUP_TIMEOUT=1800
# Jak długo model zostaje w RAM po użyciu (sekundy, -1 = na stałe, albo 30m, 2h).
# Duży model: puste = zależnie od tego, czy rozmowę przejął uczeń.
# OLLAMA_KEEP_ALIVE_BIG=
# OLLAMA_KEEP_ALIVE_SMALL=30m
# Okno kontekstu małych modeli (router, uczeń, planer).
# SMALL_NUM_CTX=4096
# Duży model z promptem routingu (krok 1b): na tym CPU wolny, domyślnie wyłączony.
# BIG_MODEL_ROUTING=0

# Zadania wielokrokowe: łączny czas jednego zadania (sekundy).
# TASK_TIME_BUDGET=600

# Namysł (agent/namysl.py, 1.9.0): twardy budżet czasu jednego kilkufazowego
# namysłu (sekundy). Po przekroczeniu dalsze fazy są pomijane z informacją w
# narracji, a odpowiedź i tak wychodzi. Tryb (auto/zawsze/wyłączony) i zgoda
# na wysyłkę fragmentów notatek do sieciowych AI są ustawiane z interfejsu
# (data/namysl.json), nie tutaj.
# NAMYSL_TIME_BUDGET=900

# Własne modele z treningu. Wpisują je skrypty training/run*.sh po udanym
# eksporcie (z kontrolą jakości); puste = model nieużywany.
# ROUTER_MODEL=
# STUDENT_MODEL=
# PLANNER_MODEL=

# Katalogi dla narzędzi plikowych SYSOP (fs_list, fs_read, fs_search), oddzielone ":".
# Puste = folder GREGAI. Wpisany tu katalog ZASTĘPUJE ten domyślny, więc dopisz też
# folder GREGAI, jeśli ma zostać. install.sh usuwa wpisy nieistniejące albo wskazujące
# starą kopię projektu, a gdy żaden nie zostanie, wpisuje folder GREGAI.
# SYSOP_ROOTS=

# Zmienne instalatora (ustawiasz w powłoce przy `bash install.sh`, NIE w .env):
#   GREGAI_HOME=~/Dokumenty/GREGAI    gdzie skopiować projekt, gdy obecny folder się nie nadaje
#   GREGAI_SKIP_HOST=1      pomiń ustawienia laptopa (usypianie, klapa, swap)
#   GREGAI_SKIP_CHECK=1     pomiń kontrolę check.sh na końcu instalacji

# Zapora WARP w jądrze (1.19.0, install.sh krok 7b): procesy usługi gregai wychodzą
# tylko przez WARP, localhost i sieć lokalną (nftables). Od 1.32.4 OBOWIĄZKOWA: nie ma
# wyłącznika, a usługa bez niej nie wystartuje.

# Ochrona logowania SSH (1.30.0, install.sh): fail2ban blokuje adres po kilku
# nieudanych próbach hasła SSH. Instalowany tylko, gdy działa serwer SSH. 0 = pomiń.
# GREGAI_FAIL2BAN=1
